{
  "info": {
    "_postman_id": "mini-clinic-api-collection",
    "name": "Mini Clinic Information System API",
    "description": "Collection API Postman lengkap untuk Mini Clinic Information System (PT Inova Medika Solusindo) mencakup Auth, Master Pasien, Pendaftaran, Antrean, SOAP + Resep, dan Dashboard Metrics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctor_id",
      "value": "11111111-1111-1111-1111-111111111104",
      "type": "string"
    },
    {
      "key": "poli_id",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "registration_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "queue_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@klinik.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login sebagai Administrator. Token otomatis disimpan ke variabel koleksi token jika dikonfigurasi script post-response."
          },
          "response": []
        },
        {
          "name": "Login Dokter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dokter@klinik.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login Petugas Pendaftaran",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pendaftaran@klinik.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Master Pasien",
      "item": [
        {
          "name": "Get All Patients (List, Search & Pagination)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients?search=&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Patient (Auto Generate No. RM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nik\": \"3271012304950001\",\n  \"name\": \"Budi Santoso\",\n  \"gender\": \"L\",\n  \"birth_date\": \"1995-04-23\",\n  \"phone\": \"081234567890\",\n  \"address\": \"Jl. Sudirman No. 12, Jakarta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients"]
            }
          },
          "response": []
        },
        {
          "name": "Get Patient By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/{{patient_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "{{patient_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso Edit\",\n  \"phone\": \"089999999999\",\n  \"address\": \"Jl. Gatot Subroto No. 45, Jakarta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients/{{patient_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "{{patient_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/{{patient_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "{{patient_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Pendaftaran Pasien",
      "item": [
        {
          "name": "Create Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"doctor_id\": \"{{doctor_id}}\",\n  \"poli_id\": \"{{poli_id}}\",\n  \"payment_type\": \"umum\",\n  \"complaint\": \"Demam dan pusing sejak kemarin malam\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations"]
            }
          },
          "response": []
        },
        {
          "name": "Get Registrations List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations"]
            }
          },
          "response": []
        },
        {
          "name": "Update Registration Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"check_in\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registration_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations", "{{registration_id}}", "status"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Antrean",
      "item": [
        {
          "name": "Create Queue (Check In & Generate Nomor Antrean)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration_id\": \"{{registration_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/queues",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queues"]
            }
          },
          "response": []
        },
        {
          "name": "Get Queue List Hari Ini",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/queues",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queues"]
            }
          },
          "response": []
        },
        {
          "name": "Update Queue Status (Panggil / Diperiksa / Selesai)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dipanggil\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/queues/{{queue_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queues", "{{queue_id}}", "status"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Pemeriksaan Dokter (SOAP) & Resep",
      "item": [
        {
          "name": "Create Medical Record (SOAP + Tindakan + Resep)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration_id\": \"{{registration_id}}\",\n  \"subjective\": \"Pasien mengeluh demam dan pusing sejak kemarin malam\",\n  \"blood_pressure\": \"120/80\",\n  \"temperature\": 37.5,\n  \"weight\": 65,\n  \"height\": 170,\n  \"diagnosis\": \"Febris ec Infeksi Saluran Pernapasan Akut (ISPA)\",\n  \"treatment_plan\": \"Istirahat cukup, minum air putih 2L/hari, minum obat teratur\",\n  \"actions\": [\n    {\n      \"action_name\": \"Pemeriksaan Fisik & TTV\",\n      \"notes\": \"Kondisi umum tampak sakit ringan\"\n    }\n  ],\n  \"prescription_items\": [\n    {\n      \"medicine_name\": \"Paracetamol 500mg\",\n      \"dosage\": \"3x1 sesudah makan\",\n      \"quantity\": 10,\n      \"instructions\": \"Bila demam\"\n    },\n    {\n      \"medicine_name\": \"Vitamin C 500mg\",\n      \"dosage\": \"1x1 sesudah makan\",\n      \"quantity text\": \"10\",\n      \"instructions\": \"Suplemen daya tahan tubuh\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medical-records",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical-records"]
            }
          },
          "response": []
        },
        {
          "name": "Get Patient Medical History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medical-records/patient/{{patient_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical-records", "patient", "{{patient_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Dashboard Metrics",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "metrics"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
